{
  "name": "game-fun-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @game/shared build && pnpm --filter @game/server dev",
    "dev:client": "pnpm --filter @game/shared build && pnpm --filter @game/client dev",
    "build": "pnpm --filter @game/shared build && pnpm --filter @game/server build && pnpm --filter @game/client build",
    "test": "pnpm --filter @game/shared build && vitest run",
    "typecheck": "pnpm --filter @game/shared typecheck && pnpm --filter @game/server typecheck && pnpm --filter @game/client typecheck"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.9.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
